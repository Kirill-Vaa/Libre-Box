HOST=0.0.0.0
PORT=3080

TRUST_PROXY=1

CREDS_KEY=REPLACE_WITH_CREDS_KEY
CREDS_IV=REPLACE_WITH_CREDS_IV

MONGO_URI=mongodb://mongodb:27017/LibreChat

DOMAIN_CLIENT=https://REPLACE_WITH_DOMAIN
DOMAIN_SERVER=https://REPLACE_WITH_DOMAIN

NO_INDEX=true

LOG_TO_FILE=true

DEPLOYMENT_PLUGINS_DIR=./plugins
DEPLOYMENT_SKILLS_DIR=./skill

ENDPOINTS=custom,agents

SERPER_API_KEY=REPLACE_WITH_SERPER_API_KEY
