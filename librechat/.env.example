COMPOSIO_API_KEY=REPLACE_WITH_COMPOSIO_API_KEY

FILE_UPLOAD_SSE_ENABLED=true

ALLOW_SHARED_LINK=true
ALLOW_SHARED_LINKS_PUBLIC=true
