COMPOSE_FILE=docker-compose.yml
DOMAIN=REPLACE_WITH_DOMAIN

MONGODB_USER=librebox
MONGODB_PASSWORD=REPLACE_WITH_MONGODB_PASSWORD

SANDBOX_CONTAINER_NAME=libre-box-sandbox
WORKSPACE_PATH=/root/data
BACKGROUND_LOG_DIR=/root/.box/logs
MCP_PORT=8080
AUTH_PORT=8081

DEFAULT_COMMAND_TIMEOUT_SECONDS=600
OUTPUT_CHAR_LIMIT=100000
SESSION_IDLE_TTL_SECONDS=3600

LOG_LEVEL=INFO
LOG_SERIALIZE=true