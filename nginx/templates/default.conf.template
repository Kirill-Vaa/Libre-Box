server {
    listen 80 default_server;
    listen 443 ssl default_server;
    ssl_reject_handshake on;
    return 444;
}

server {
    listen 80;
    server_name ${DOMAIN};

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/certbot;
        default_type "text/plain";
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    http2 on;
    server_name ${DOMAIN};

    ssl_certificate     /etc/nginx/certs/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/privkey.pem;
    include /etc/nginx/snippets/tls.conf;

    include /etc/nginx/snippets/security-headers.conf;

    limit_conn conn_per_ip 50;

    location = /_auth {
        internal;
        set $mcp_auth http://mcp:8081;
        proxy_pass $mcp_auth/auth/validate;
        proxy_pass_request_body off;
        proxy_set_header Content-Length "";
        proxy_set_header Cookie $http_cookie;
    }

    location /files/ {
        limit_req zone=req_general burst=60 nodelay;
        auth_request /_auth;
        auth_request_set $auth_user $upstream_http_x_auth_user;
        error_page 401 = @login;
        set $filebrowser_upstream http://filebrowser:80;
        proxy_pass $filebrowser_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Auth-User $auth_user;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location @login {
        return 302 /login;
    }

    location /api/auth/ {
        limit_req zone=req_login burst=10 nodelay;
        set $librechat_upstream http://librechat:3080;
        proxy_pass $librechat_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location = /librebox/inject.js {
        limit_req zone=req_general burst=60 nodelay;
        alias /etc/nginx/assets/inject.js;
    }

    location / {
        limit_req zone=req_general burst=100 nodelay;
        set $librechat_upstream http://librechat:3080;
        proxy_pass $librechat_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Accept-Encoding "";
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        proxy_buffering off;
        proxy_cache off;
        sub_filter_once on;
        sub_filter "</head>" "<script src=\"/librebox/inject.js\" defer></script></head>";
    }
}